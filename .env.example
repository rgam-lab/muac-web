# Required: your ngrok auth token (https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=NGROK_AUTHTOKEN

# Optional: use your reserved ngrok domain (must be reserved on your ngrok account)
